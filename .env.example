# Copie para .env e preencha. Este arquivo é versionado; o .env não.
DATABASE_URL=postgresql://postgres:TROQUE_ESTA_SENHA@localhost:5432/estudo
PORT=3000

# Gere um novo: node -pe "require('crypto').randomBytes(32).toString('hex')"
JWT_SECRET=

CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Usada pelo docker-compose para inicializar o Postgres.
# Precisa bater com a senha da DATABASE_URL acima.
POSTGRES_PASSWORD=TROQUE_ESTA_SENHA
